{
  "name": "liveworld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build a tabletop world, find what breaks, and verify the fix.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:config": "node scripts/check-meta-config.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:local": "node scripts/check-local.mjs"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0"
  },
  "devDependencies": {
    "mediabunny": "1.62.1",
    "prettier": "3.9.10"
  }
}
