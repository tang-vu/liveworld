# Put your own key in .env.local. Never commit the real key.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_REASONING_MODEL=muse-spark-1.3
META_SEGMENTATION_MODEL=sam-3.1

# USD. Start with a $10 development phase within the $150 total budget.
# These are configuration values; provider billing is the source of truth.
LIVEWORLD_TOTAL_BUDGET_USD=150
LIVEWORLD_PHASE_BUDGET_USD=10
LIVEWORLD_RESERVE_USD=50
